flowchart TD
    start1((开始)) --> tap[玩家点击棋盘交叉点]
    tap --> isOver{对局是否已结束}
    isOver -->|是| tipOver[提示：对局已结束]
    tipOver --> end1((结束))
    isOver -->|否| empty{该交叉点是否为空}
    empty -->|否| tipOcc[提示：该点已有棋子]
    tipOcc --> tap
    empty -->|是| confirm{是否开启落子确认}
    confirm -->|是| same{再次点击同一点或按下确认}
    same -->|否| pending[进入待确认状态]
    pending --> tap
    same -->|是| forbidChk
    confirm -->|否| forbidChk{是否黑棋且开启禁手}
    forbidChk -->|是| forbid{是否双三、双四或长连}
    forbid -->|是| tipF[拒绝落子并提示禁手]
    tipF --> tap
    forbid -->|否| place
    forbidChk -->|否| place[落下当前方棋子]
    place --> five{是否连成五子}
    five -->|是| win[判定当前方获胜<br/>高亮胜线并弹窗]
    win --> end1
    five -->|否| full{棋盘是否已满}
    full -->|是| komi{是否设置贴目}
    komi -->|是| whiteWin[判白胜]
    komi -->|否| draw[判和棋]
    whiteWin --> end1
    draw --> end1
    full -->|否| turn[换手：对方走子]
    turn --> tap
